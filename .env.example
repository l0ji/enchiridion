# Uncomment one provider and add its API key.
#OPENAI_API_KEY=add-key
#OPENCODE_API_KEY=add-key
#ANTHROPIC_API_KEY=add-key

# Required for Docker Compose or any HTTP bind outside loopback.
# Generate a token with: openssl rand -hex 32
#ENCHIRIDION_HTTP_TOKEN=add-token

# Only needed for Fluxer.
#FLUXER_BOT_TOKEN=add-token
